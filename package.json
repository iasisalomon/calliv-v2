{
  "name": "calliv-v2",
  "version": "2.0.0",
  "description": "A calibration-curve tool for biological sciences: upload plate-reader results as a CSV, organize the readings and fit a linear regression to the standards.",
  "keywords": [
    "calibration-curve",
    "biotechnology",
    "plate-reader",
    "linear-regression",
    "tensorflowjs",
    "nuxt"
  ],
  "homepage": "https://github.com/iasisalomon/calliv-v2#readme",
  "bugs": {
    "url": "https://github.com/iasisalomon/calliv-v2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iasisalomon/calliv-v2.git"
  },
  "license": "MIT",
  "author": "Iasi Salomon (https://iasisalomon.pages.dev)",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "deploy": "nuxt generate && pnpm dlx wrangler deploy",
    "lint:js": "eslint --ext \".js,.vue\" --ignore-path .gitignore .",
    "lint": "pnpm run lint:js"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-cpu": "^3.21.0",
    "@tensorflow/tfjs-core": "^3.21.0",
    "bootstrap": "^4.6.0",
    "bootstrap-vue": "^2.22.0",
    "core-js": "^3.22.3",
    "highcharts": "^9.3.3",
    "highcharts-vue": "^1.4.0",
    "lodash": "^4.17.21",
    "nuxt": "^2.15.3",
    "vue-lodash": "^2.1.2",
    "vue-papa-parse": "^2.0.0",
    "vuex-persistedstate": "^4.1.0"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config": "^6.0.0",
    "@nuxtjs/eslint-module": "^3.1.0",
    "prettier": "^2.6.2"
  }
}
